<!-- 学术风格模板 - 适合研究论文、技术深度分析 -->
<div style="
    max-width: 750px;
    margin: 0 auto;
    padding: 20px 16px;
    font-family: 'Times New Roman', 'SimSun', serif;
    line-height: 1.9;
    color: #222;
    background: #fcfcfc;
  ">

  <!-- 目录 (TOC) -->
  <% if (articles.length > 1) { %>
  <div style="
      margin: 24px 0 32px;
      padding: 24px;
      background: #ffffff;
      border: 1px solid #d0d0d0;
      border-radius: 4px;
    ">
    <div style="
          margin-bottom: 16px;
          font-size: 16px;
          font-weight: 700;
          color: #1a1a1a;
          text-align: center;
          text-transform: uppercase;
          letter-spacing: 2px;
        ">Contents</div>
    
    <% for(var i=0; i<articles.length; i++) { %>
      <div style="
            margin: 10px 0;
            padding-left: 20px;
            font-size: 14px;
            color: #444;
            line-height: 1.6;
          ">
        <span style="font-weight: 600; margin-right: 8px;"><%= i + 1 %>.</span>
        <span><%= articles[i].title %></span>
      </div>
    <% } %>
  </div>
  <% } %>

  <!-- 文章列表 -->
  <% for(var j=0; j<articles.length; j++) { var article=articles[j]; %>
    
    <% if (articles.length > 1) { %>
    <!-- 章节标题 (Section Header) -->
    <div style="
          margin: 40px 0 24px;
          padding: 16px 0 12px;
          border-top: 2px solid #333;
          border-bottom: 1px solid #d0d0d0;
        ">
      <h2 style="
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #1a1a1a;
            line-height: 1.3;
          ">
        <span style="
              display: inline-block;
              min-width: 32px;
              text-align: center;
              color: #666;
              font-size: 18px;
              margin-right: 10px;
            "><%= j + 1 %>.</span>
        <%= article.title %>
      </h2>
      
      <% if(article.subtitle) { %>
        <p style="
              margin: 8px 0 0 42px;
              font-size: 14px;
              font-style: italic;
              color: #666;
            "><%= article.subtitle %></p>
      <% } %>
      
      <!-- 元信息 -->
      <div style="
            margin-top: 12px;
            padding-left: 42px;
            font-size: 12px;
            color: #888;
          ">
        <span>Published: <%= article.publishDate %></span>
        <% if(article.metadata && article.metadata.source) { %>
          <span style="margin: 0 8px;">|</span>
          <span>Source: <%= article.metadata.source %></span>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- 正文内容 -->
    <div style="
          margin: 20px 0;
          padding: 0;
          font-size: 15px;
          color: #333;
          line-height: 1.9;
          text-align: justify;
          text-indent: 0;
        ">
      <%- article.content %>
    </div>

    <!-- 关键词 -->
    <% if(article.keywords && article.keywords.length > 0) { %>
      <div style="
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px dotted #d0d0d0;
            font-size: 13px;
            color: #666;
          ">
        <strong>Keywords:</strong>
        <% for(var k=0; k<article.keywords.length; k++) { %>
          <span style="
                margin: 0 6px;
                padding: 3px 10px;
                background: #f5f5f5;
                border: 1px solid #e0e0e0;
                border-radius: 3px;
                font-style: italic;
              "><%= article.keywords[k] %></span>
        <% } %>
      </div>
    <% } %>

    <% if (j < articles.length - 1) { %>
    <!-- 章节分隔 -->
    <div style="margin: 48px auto; width: 80%; height: 1px; background: #d0d0d0;"></div>
    <% } %>
  <% } %>

</div>
