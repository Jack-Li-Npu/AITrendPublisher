<!-- 未来科技风格 - 现代感、科技感、渐变色 -->
<div style="
    margin: 0;
    padding: 0;
    font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
    line-height: 1.7;
    color: #1a1a2e;
    background: linear-gradient(to bottom, #0f0c29, #302b63, #24243e);
  ">

  <!-- 顶部装饰 -->
  <div style="height: 8px; background: linear-gradient(90deg, #00d2ff 0%, #3a47d5 100%);"></div>

  <!-- 主容器 -->
  <div style="margin: 0; padding: 20px 12px; background: #ffffff;">
    
    <!-- 全息目录 -->
    <div style="
        margin: 20px 8px;
        padding: 24px 20px;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(30, 60, 114, 0.3);
      ">
      <!-- 标题 -->
      <div style="
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid rgba(255,255,255,0.2);
            text-align: center;
          ">
        <span style="
              color: #00d2ff;
              font-size: 20px;
              font-weight: 700;
              text-shadow: 0 0 10px rgba(0,210,255,0.5);
            ">⚡ 今日精选</span>
      </div>

      <!-- 目录项 -->
      <% for(var i=0; i<articles.length; i++) { var article=articles[i]; 
         var colors = ['#00d2ff', '#ff6b6b', '#4ecdc4', '#ffe66d', '#a8e6cf'];
         var currentColor = colors[i % colors.length];
      %>
        <div style="
              margin: 12px 0;
              padding: 16px;
              background: rgba(255,255,255,0.1);
              border-left: 4px solid <%= currentColor %>;
              border-radius: 6px;
              backdrop-filter: blur(10px);
            ">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="width: 36px; vertical-align: top;">
                <div style="
                      width: 32px;
                      height: 32px;
                      line-height: 32px;
                      text-align: center;
                      background: <%= currentColor %>;
                      color: #1a1a2e;
                      font-size: 14px;
                      font-weight: 700;
                      border-radius: 8px;
                      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
                    "><%= (i + 1).toString().padStart(2, '0') %></div>
              </td>
              <td style="padding-left: 12px; vertical-align: middle;">
                <div style="color: #ffffff; font-size: 15px; font-weight: 500; line-height: 1.5;">
                  <%= article.title %>
                </div>
              </td>
            </tr>
          </table>
        </div>
      <% } %>
    </div>

    <!-- 文章内容 -->
    <% for(var j=0; j<articles.length; j++) { var article=articles[j]; 
       var colors = ['#00d2ff', '#ff6b6b', '#4ecdc4', '#ffe66d', '#a8e6cf'];
       var themeColor = colors[j % colors.length];
    %>
      <div style="
            margin: 24px 8px;
            background: #ffffff;
            border: 1px solid #e8e8e8;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
          ">
        
        <!-- 文章头部 -->
        <div style="
              padding: 24px 20px;
              background: linear-gradient(135deg, <%= themeColor %> 0%, <%= themeColor %>dd 100%);
            ">
          <!-- 标签 -->
          <div style="margin-bottom: 14px;">
            <span style="
                  display: inline-block;
                  padding: 6px 16px;
                  background: rgba(26,26,46,0.8);
                  color: #ffffff;
                  font-size: 11px;
                  font-weight: 600;
                  border-radius: 20px;
                  letter-spacing: 1px;
                  text-transform: uppercase;
                ">Article <%= (j + 1).toString().padStart(2, '0') %></span>
            
            <% if(article.keywords && article.keywords.length > 0) { %>
              <% for(var k=0; k<Math.min(article.keywords.length, 2); k++) { %>
                <span style="
                      display: inline-block;
                      padding: 4px 12px;
                      margin-left: 8px;
                      background: rgba(255,255,255,0.25);
                      color: #ffffff;
                      font-size: 11px;
                      border-radius: 12px;
                    ">#<%= article.keywords[k] %></span>
              <% } %>
            <% } %>
          </div>

          <!-- 标题 -->
          <h2 style="
                margin: 0;
                font-size: 24px;
                font-weight: 700;
                color: #1a1a2e;
                line-height: 1.3;
                text-shadow: 0 2px 4px rgba(255,255,255,0.3);
              "><%= article.title %></h2>
        </div>

        <!-- 正文 -->
        <div style="
              padding: 28px 24px;
              font-size: 15px;
              color: #2c3e50;
              line-height: 1.9;
              text-align: justify;
            ">
          <%- article.content %>
        </div>
      </div>

      <% if (j < articles.length - 1) { %>
      <!-- 文章间隔 -->
      <div style="
            margin: 32px auto;
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, transparent, <%= themeColor %>, transparent);
            border-radius: 2px;
          "></div>
      <% } %>
    <% } %>

  </div>

  <!-- 底部装饰 -->
  <div style="height: 8px; background: linear-gradient(90deg, #00d2ff 0%, #3a47d5 100%);"></div>

</div>
