<!-- 极简风格模板 - 最大化内容，最小化装饰 -->
<div style="
    max-width: 720px;
    margin: 0 auto;
    padding: 20px 16px;
    font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
    line-height: 1.75;
    color: #2c3e50;
    background: #ffffff;
  ">
  
  <!-- 简洁目录 -->
  <% if (articles.length > 1) { %>
  <div style="margin: 24px 0; padding: 20px; background: #fafafa; border-left: 4px solid #333;">
    <div style="font-size: 14px; font-weight: 600; color: #333; margin-bottom: 16px;">目录</div>
    <% for(var i=0; i<articles.length; i++) { %>
      <div style="margin: 8px 0; font-size: 14px; color: #555;">
        <span style="color: #999; margin-right: 8px;"><%= i + 1 %>.</span>
        <span><%= articles[i].title %></span>
      </div>
    <% } %>
  </div>
  <% } %>

  <!-- 文章内容 -->
  <% for(var j=0; j<articles.length; j++) { var article=articles[j]; %>
    
    <% if (articles.length > 1) { %>
    <!-- 多篇文章时显示标题 -->
    <h2 style="
          margin: 32px 0 20px;
          font-size: 24px;
          font-weight: 700;
          color: #1a1a1a;
          line-height: 1.3;
          border-bottom: 2px solid #e8e8e8;
          padding-bottom: 12px;
        ">
      <span style="color: #999; font-size: 18px; margin-right: 12px;"><%= j + 1 %>.</span>
      <%= article.title %>
    </h2>
    <% } %>

    <!-- 正文 -->
    <div style="
          margin: 16px 0;
          font-size: 15px;
          color: #34495e;
          line-height: 1.8;
          text-align: justify;
        ">
      <%- article.content %>
    </div>

    <% if (j < articles.length - 1) { %>
    <!-- 文章分隔线 -->
    <div style="margin: 48px auto; width: 60px; height: 1px; background: #ddd;"></div>
    <% } %>
  <% } %>

</div>
