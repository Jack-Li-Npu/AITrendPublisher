<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrendPublish 控制面板</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <style id="md-theme-variables"></style>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f9fafb; }
        .terminal { background-color: #1e1e1e; color: #d4d4d4; font-family: 'Fira Code', monospace; }
        .log-entry { margin-bottom: 2px; line-height: 1.4; font-size: 13px; }
        .log-info { color: #4ec9b0; }
        .log-warn { color: #ce9178; }
        .log-error { color: #f44747; }
        .log-timestamp { color: #808080; margin-right: 8px; }
        .loader { border-top-color: #3498db; animation: spinner 1.5s linear infinite; }
        @keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">
    <!-- Header -->
    <header class="bg-white border-b px-6 py-4 flex items-center justify-between shadow-sm z-10">
        <div class="flex items-center space-x-3">
            <div class="bg-blue-600 p-2 rounded-lg text-white">
                <i class="fas fa-paper-plane"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800 tracking-tight">TrendPublish <span class="text-sm font-normal text-gray-500 ml-2">v2.0</span></h1>
        </div>
        <div class="flex items-center space-x-4">
            <span id="connection-status" class="flex items-center text-xs text-green-500 font-medium">
                <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span> 服务已连接
            </span>
            <button onclick="toggleConfig()" class="text-gray-600 hover:text-blue-600 transition-colors">
                <i class="fas fa-cog text-lg"></i>
            </button>
        </div>
    </header>

    <main class="flex-1 flex overflow-hidden">
            <!-- Sidebar: Control & Mode -->
            <aside class="w-80 bg-white border-r p-6 overflow-y-auto flex flex-col shadow-sm">
                <div class="mb-8">
                <label class="block text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wider">运行模式</label>
                <div class="space-y-2">
                    <button onclick="setMode('TECH_NEWS')" id="mode-TECH_NEWS" class="mode-btn w-full flex items-center p-3 rounded-xl border transition-all hover:bg-blue-50 hover:border-blue-200">
                        <i class="fas fa-newspaper w-8 text-blue-500"></i>
                        <div class="text-left">
                            <div class="font-semibold text-sm">科技新闻</div>
                            <div class="text-xs text-gray-500">爬取多源深度 AI 资讯</div>
                        </div>
                    </button>
                    <button onclick="setMode('GITHUB_TRENDING')" id="mode-GITHUB_TRENDING" class="mode-btn w-full flex items-center p-3 rounded-xl border transition-all hover:bg-purple-50 hover:border-purple-200">
                        <i class="fab fa-github w-8 text-purple-500"></i>
                        <div class="text-left">
                            <div class="font-semibold text-sm">GitHub Trending</div>
                            <div class="text-xs text-gray-500">解析热门项目 README</div>
                        </div>
                    </button>
                    <button onclick="setMode('SINGLE_URL')" id="mode-SINGLE_URL" class="mode-btn w-full flex items-center p-3 rounded-xl border transition-all hover:bg-orange-50 hover:border-orange-200">
                        <i class="fas fa-link w-8 text-orange-500"></i>
                        <div class="text-left">
                            <div class="font-semibold text-sm">单链接爬取</div>
                            <div class="text-xs text-gray-500">指定 URL 进行深度翻译</div>
                        </div>
                    </button>
                    <button onclick="setMode('TOPIC_SEARCH')" id="mode-TOPIC_SEARCH" class="mode-btn w-full flex items-center p-3 rounded-xl border transition-all hover:bg-green-50 hover:border-green-200">
                        <i class="fas fa-search w-8 text-green-500"></i>
                        <div class="text-left">
                            <div class="font-semibold text-sm">主题搜索</div>
                            <div class="text-xs text-gray-500">根据关键词全网搜寻</div>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Parameters -->
            <div class="space-y-6 mb-8">
                <div id="param-url" class="hidden">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">文章 URL</label>
                    <input type="text" id="url-input" placeholder="https://..." class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all text-sm">
                </div>
                <div id="param-topic" class="hidden">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">搜索主题</label>
                    <input type="text" id="topic-input" placeholder="例如：AI 代理..." class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all text-sm">
                </div>
                <div>
                    <div class="flex justify-between mb-2">
                        <label class="text-sm font-semibold text-gray-700">内容长度 (字数)</label>
                        <span id="word-range-val" class="text-xs text-blue-600 font-bold">2000 - 3000</span>
                    </div>
                    <div class="flex items-center space-x-4">
                        <input type="range" id="min-words" min="500" max="5000" step="100" value="2000" oninput="updateWordRange()" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
                        <input type="range" id="max-words" min="1000" max="10000" step="100" value="3000" oninput="updateWordRange()" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">最大采集篇数</label>
                    <select id="max-articles" class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none transition-all text-sm bg-white cursor-pointer">
                        <option value="1">1 篇</option>
                        <option value="3">3 篇</option>
                        <option value="5" selected>5 篇</option>
                        <option value="8">8 篇</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">文章模板</label>
                    <select id="article-template" onchange="tryUpdatePreview()" class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none transition-all text-sm bg-white cursor-pointer">
                        <option value="default">Doocs: 默认 (Classic)</option>
                        <option value="elegant">Doocs: 优雅 (Elegant)</option>
                        <option value="simple">Doocs: 简约 (Simple)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">自定义结语</label>
                    <textarea id="custom-footer" rows="3" onblur="tryUpdatePreview()" placeholder="不填则使用 AI 自动生成..." class="w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none transition-all text-sm resize-none"></textarea>
                    <p class="text-[10px] text-gray-400 mt-1">支持部分 HTML 标签，预览时可实时更新</p>
                </div>
            </div>

            <!-- Run Button -->
            <div class="mt-auto pt-6 border-t">
                <button id="run-btn" onclick="runWorkflow()" class="w-full bg-blue-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-blue-200 hover:bg-blue-700 active:transform active:scale-95 transition-all flex items-center justify-center">
                    <i class="fas fa-play mr-2"></i> 开始运行任务
                </button>
                <div id="running-status" class="hidden mt-4">
                    <div class="flex items-center justify-center space-x-2 text-blue-600 font-medium text-sm animate-pulse">
                        <div class="loader ease-linear rounded-full border-2 border-t-2 border-gray-200 h-4 w-4"></div>
                        <span>任务执行中...</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content: Log & Preview -->
        <div class="flex-1 flex flex-col bg-gray-50 overflow-hidden relative">
            
            <!-- Log Console -->
            <div class="flex-1 p-6 overflow-hidden flex flex-col">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest"><i class="fas fa-terminal mr-2"></i> 实时运行日志</h2>
                    <button onclick="clearLogs()" class="text-xs text-gray-400 hover:text-gray-600">清空记录</button>
                </div>
                <div id="terminal" class="terminal flex-1 rounded-xl p-4 overflow-y-auto shadow-inner text-sm border border-gray-800">
                    <div class="log-entry"><span class="log-timestamp">[欢迎]</span> 系统已就绪，请选择模式并点击“开始运行”。</div>
                </div>
            </div>

            <!-- Article Preview Modal (Overlays Log) -->
            <div id="preview-container" class="hidden absolute inset-0 z-20 bg-white flex flex-col border-l border-gray-200 transform translate-x-full transition-transform duration-300 ease-in-out shadow-2xl">
                <div class="px-6 py-4 border-b flex items-center justify-between bg-white sticky top-0">
                    <div class="flex items-center space-x-3">
                        <button onclick="closePreview()" class="text-gray-400 hover:text-gray-600">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                        <h2 class="text-lg font-bold text-gray-800"><i class="fas fa-eye mr-2 text-blue-500"></i> 文章预览</h2>
                    </div>
                    <div class="flex items-center space-x-3">
                        <select id="preview-template" onchange="syncTemplateFromPreview()" class="p-2 text-sm border rounded-lg bg-white outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="default">Doocs: 默认 (Classic)</option>
                            <option value="elegant">Doocs: 优雅 (Elegant)</option>
                            <option value="simple">Doocs: 简约 (Simple)</option>
                        </select>
                        <button onclick="openRefinePanel()" class="px-4 py-2 text-sm font-medium text-purple-600 hover:bg-purple-50 rounded-lg transition-colors flex items-center">
                            <i class="fas fa-magic mr-2"></i> 再改改
                        </button>
                        <button onclick="publishArticle()" id="publish-btn" class="px-6 py-2 bg-green-600 text-white text-sm font-bold rounded-lg shadow-md hover:bg-green-700 active:scale-95 transition-all flex items-center">
                            <i class="fas fa-cloud-upload-alt mr-2"></i> 确认发布到公众号
                        </button>
                    </div>
                </div>
                <div class="flex-1 overflow-y-auto p-8 bg-gray-50">
                    <div class="max-w-2xl mx-auto bg-white p-10 shadow-sm border rounded-lg min-h-screen" id="preview-content">
                        <!-- Preview HTML will be injected here -->
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Config Modal -->
    <div id="config-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="px-8 py-6 border-b flex items-center justify-between bg-blue-50">
                <div>
                    <h2 class="text-xl font-bold text-gray-800 tracking-tight">配置中心</h2>
                    <p class="text-xs text-gray-500 mt-1">修改环境变量 (.env) 并持久化到磁盘</p>
                </div>
                <button onclick="toggleConfig()" class="text-gray-400 hover:text-gray-600 bg-white p-2 rounded-full shadow-sm">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto p-8">
                <!-- Tab Switcher -->
                <div class="flex items-center justify-center mb-6 bg-gray-100 p-2 rounded-xl">
                    <button type="button" id="tab-official" onclick="switchApiSourceTab('official')" class="api-source-tab flex-1 px-6 py-3 rounded-lg font-bold text-sm transition-all bg-white shadow-md text-blue-600">
                        🏢 官方 API 直连
                    </button>
                    <button type="button" id="tab-proxy" onclick="switchApiSourceTab('proxy')" class="api-source-tab flex-1 px-6 py-3 rounded-lg font-bold text-sm transition-all text-gray-500 hover:bg-gray-50">
                        🔄 中转服务
                    </button>
                </div>

                <form id="config-form" class="space-y-6">
                    <!-- Hidden field to store API_SOURCE_TYPE -->
                    <input type="hidden" name="API_SOURCE_TYPE" id="api-source-type-input" value="official" class="config-input">

                    <!-- 官方 API 配置面板 -->
                    <div id="official-config-panel" class="space-y-6">
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                            <p class="text-sm text-blue-700 flex items-center">
                                <i class="fas fa-info-circle mr-2"></i>
                                <strong>官方直连模式：</strong>直接使用各服务商官方 API，需在对应网站申请密钥
                            </p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Google Gemini -->
                            <div class="space-y-4">
                                <h3 class="text-xs font-bold text-blue-600 uppercase tracking-widest border-b pb-2 flex items-center">
                                    <i class="fas fa-key mr-2"></i> Google Gemini
                                </h3>
                                <div>
                                    <label class="block text-xs font-medium text-gray-500 mb-1">GEMINI_API_KEY</label>
                                    <input type="password" name="GEMINI_API_KEY" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                                    <a href="https://aistudio.google.com/apikey" target="_blank" class="text-[10px] text-blue-500 hover:underline mt-1 inline-block">→ 获取 Gemini API Key</a>
                                </div>
                            </div>

                            <!-- DeepSeek -->
                            <div class="space-y-4">
                                <h3 class="text-xs font-bold text-purple-600 uppercase tracking-widest border-b pb-2 flex items-center">
                                    <i class="fas fa-key mr-2"></i> DeepSeek
                                </h3>
                                <div>
                                    <label class="block text-xs font-medium text-gray-500 mb-1">DEEPSEEK_API_KEY</label>
                                    <input type="password" name="DEEPSEEK_API_KEY" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-purple-500">
                                    <a href="https://platform.deepseek.com/api_keys" target="_blank" class="text-[10px] text-purple-500 hover:underline mt-1 inline-block">→ 获取 DeepSeek API Key</a>
                                </div>
                            </div>
                        </div>

                        <!-- 阿里云配置 -->
                        <div class="p-4 bg-gradient-to-r from-orange-50 to-yellow-50 border-2 border-orange-200 rounded-lg shadow-sm">
                                <h4 class="text-sm font-bold text-orange-700 mb-3 flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/></svg>
                                    阿里云 API 配置 (通义千问 & 通义万相)
                                </h4>
                                
                                <!-- 区域选择器 -->
                                <div class="mb-4">
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">服务区域</label>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button type="button" id="aliyun-region-cn" onclick="selectAliyunRegion('cn')" class="aliyun-region-btn p-3 border-2 border-orange-300 rounded-lg bg-white hover:bg-orange-50 transition-all text-sm font-medium text-gray-700">
                                            🇨🇳 国内版
                                            <div class="text-xs text-gray-500 mt-1">dashscope.aliyuncs.com</div>
                                        </button>
                                        <button type="button" id="aliyun-region-intl" onclick="selectAliyunRegion('intl')" class="aliyun-region-btn p-3 border-2 border-gray-300 rounded-lg bg-white hover:bg-orange-50 transition-all text-sm font-medium text-gray-700">
                                            🌍 国际版
                                            <div class="text-xs text-gray-500 mt-1">dashscope-intl.aliyuncs.com</div>
                                        </button>
                                    </div>
                                    <input type="hidden" name="DASHSCOPE_REGION" id="dashscope-region-input" value="cn" class="config-input">
                                </div>

                                <!-- API Key 输入 - 动态显示 -->
                                <div id="aliyun-api-key-container">
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">
                                        <span id="aliyun-api-key-label">阿里云 API Key (国内版)</span>
                                    </label>
                                    <input type="password" name="DASHSCOPE_API_KEY" id="dashscope-api-key-input" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-orange-500" placeholder="sk-xxxxxxxxxxxxxxxx">
                                    <p class="text-xs text-gray-500 mt-2" id="aliyun-api-key-hint">
                                        💡 此密钥将用于通义千问文本模型和通义万相图片模型
                                    </p>
                                </div>
                            </div>

                            <!-- 国际 AI 服务配置 (OpenAI/Claude/Gemini) -->
                            <div class="col-span-2 p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border border-blue-200 mt-4">
                                <h4 class="text-sm font-bold text-blue-700 mb-3 flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/></svg>
                                    国际 AI 服务配置 (OpenAI / Claude / Gemini)
                                </h4>
                                
                                <!-- API 来源选择 -->
                                <div class="mb-4">
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">API 来源</label>
                                    <div class="grid grid-cols-2 gap-2">
                                        <button type="button" id="api-source-official" onclick="selectApiSource('official')" class="api-source-btn p-3 border-2 border-blue-300 rounded-lg bg-white hover:bg-blue-50 transition-all text-sm font-medium text-gray-700">
                                            🏢 官方 API
                                            <div class="text-xs text-gray-500 mt-1">直接对接服务商</div>
                                        </button>
                                        <button type="button" id="api-source-proxy" onclick="selectApiSource('proxy')" class="api-source-btn p-3 border-2 border-gray-300 rounded-lg bg-white hover:bg-blue-50 transition-all text-sm font-medium text-gray-700">
                                            🔄 中间服务
                                            <div class="text-xs text-gray-500 mt-1">使用代理/中转 API</div>
                                        </button>
                                    </div>
                                    <input type="hidden" name="API_SOURCE_TYPE" id="api-source-input" value="official" class="config-input">
                                </div>

                                <!-- 官方 API 配置区域 -->
                                <div id="official-api-config" class="space-y-3">
                                    <p class="text-xs text-gray-600 bg-blue-50 p-2 rounded border border-blue-200">
                                        💡 使用官方 API，请在各服务商官网申请密钥并配置到左侧对应的输入框
                                    </p>
                                    <div class="grid grid-cols-3 gap-2 text-xs">
                                        <a href="https://platform.openai.com/api-keys" target="_blank" class="p-2 border rounded hover:bg-blue-50 text-center">
                                            🔗 OpenAI 官网
                                        </a>
                                        <a href="https://console.anthropic.com/" target="_blank" class="p-2 border rounded hover:bg-blue-50 text-center">
                                            🔗 Claude 官网
                                        </a>
                                        <a href="https://aistudio.google.com/apikey" target="_blank" class="p-2 border rounded hover:bg-blue-50 text-center">
                                            🔗 Gemini 官网
                                        </a>
                                    </div>
                                </div>

                                <!-- 中间服务 API 配置区域 -->
                                <div id="proxy-api-config" class="space-y-3 hidden">
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-700 mb-2">中间服务 Base URL</label>
                                        <input type="text" name="PROXY_BASE_URL" id="proxy-base-url-input" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://api.yourproxy.com/v1">
                                        <p class="text-xs text-gray-500 mt-1">请输入服务提供商给你的 API 地址</p>
                                    </div>
                                    
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-700 mb-2">中间服务 API Key</label>
                                        <input type="password" name="PROXY_API_KEY" id="proxy-api-key-input" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="sk-proxy-xxxxxxxxxxxxxxxx">
                                    </div>

                                    <div class="p-3 bg-blue-50 rounded-lg border border-blue-100">
                                        <label class="block text-xs font-bold text-blue-700 mb-2">已启用的中转模型类型</label>
                                        <div class="flex flex-wrap gap-2">
                                            <span class="inline-flex items-center px-2 py-1 bg-white border border-blue-200 rounded text-[10px] font-bold text-blue-600">
                                                <i class="fas fa-check-circle mr-1"></i> GPT (OpenAI)
                                            </span>
                                            <span class="inline-flex items-center px-2 py-1 bg-white border border-blue-200 rounded text-[10px] font-bold text-blue-600">
                                                <i class="fas fa-check-circle mr-1"></i> Claude (Anthropic)
                                            </span>
                                            <span class="inline-flex items-center px-2 py-1 bg-white border border-blue-200 rounded text-[10px] font-bold text-blue-600">
                                                <i class="fas fa-check-circle mr-1"></i> Gemini (Google)
                                            </span>
                                        </div>
                                        <p class="text-[10px] text-gray-500 mt-2">💡 开启“中间服务”后，以上三类模型将自动通过代理访问。DeepSeek/Qwen 建议直连官方（速度更快）。</p>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">FIRE_CRAWL_API_KEY</label>
                                <input type="password" name="FIRE_CRAWL_API_KEY" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>
                        <!-- Wechat & Others -->
                        <div class="space-y-4">
                            <h3 class="text-xs font-bold text-green-600 uppercase tracking-widest border-b pb-2">微信与通知</h3>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">WEIXIN_APP_ID</label>
                                <input type="text" name="WEIXIN_APP_ID" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">WEIXIN_APP_SECRET</label>
                                <input type="password" name="WEIXIN_APP_SECRET" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">BARK_URL</label>
                                <input type="text" name="BARK_URL" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>
                    </div>
                    <!-- System -->
                    <div class="space-y-4 pt-4 border-t">
                        <h3 class="text-xs font-bold text-gray-600 uppercase tracking-widest border-b pb-2">系统设置</h3>
                        <div class="grid grid-cols-1 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">微信作者</label>
                                <input type="text" name="AUTHOR" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">默认封面图片 URL (可选)</label>
                                <input type="text" name="DEFAULT_COVER_IMAGE_URL" class="config-input w-full p-2 text-sm border rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://example.com/default-cover.png">
                                <p class="text-xs text-gray-400 mt-1">当封面图片生成失败时使用此图片作为备用</p>
                            </div>
                        </div>
                    </div>
                    <!-- Model Selection -->
                    <div class="space-y-4 pt-4 border-t">
                        <div class="flex items-center justify-between border-b pb-2">
                            <h3 class="text-xs font-bold text-purple-600 uppercase tracking-widest">模型选择</h3>
                            <span class="text-[10px] text-gray-400 bg-gray-100 px-2 py-0.5 rounded">⚠️ 配置将应用到所有任务</span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">内容总结/翻译模型 (主要)</label>
                                <select name="AI_SUMMARIZER_LLM_PROVIDER" class="config-input w-full p-2 text-sm border rounded-lg bg-white outline-none focus:ring-2 focus:ring-purple-500">
                                    <optgroup label="Google Gemini (推荐)">
                                        <option value="GEMINI:gemini-2.0-flash">GEMINI: Gemini 2.0 Flash</option>
                                        <option value="GEMINI:gemini-2.0-flash-exp">GEMINI: Gemini 2.0 Flash Exp</option>
                                        <option value="GEMINI:gemini-flash-lite-latest">GEMINI: Gemini Flash Lite</option>
                                    </optgroup>
                                    <optgroup label="DeepSeek (中英深度)">
                                        <option value="DEEPSEEK:deepseek-chat">DEEPSEEK: DeepSeek V3</option>
                                        <option value="DEEPSEEK:deepseek-reasoner">DEEPSEEK: DeepSeek R1 (推理)</option>
                                    </optgroup>
                                    <optgroup label="Anthropic">
                                        <option value="CLAUDE:claude-3-5-sonnet-20241022">CLAUDE: Claude 3.5 Sonnet</option>
                                    </optgroup>
                                    <optgroup label="Alibaba Qwen">
                                        <option value="QWEN:qwen-max">QWEN: Qwen Max</option>
                                        <option value="QWEN:qwen-plus">QWEN: Qwen Plus</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">信息预提取模型 (快速)</label>
                                <select name="AI_PRE_EXTRACT_LLM_PROVIDER" class="config-input w-full p-2 text-sm border rounded-lg bg-white outline-none focus:ring-2 focus:ring-purple-500">
                                    <option value="GEMINI:gemini-flash-lite-latest">GEMINI: Gemini Flash Lite (推荐)</option>
                                    <option value="GEMINI:gemini-2.0-flash">GEMINI: Gemini 2.0 Flash</option>
                                    <option value="DEEPSEEK:deepseek-chat">DEEPSEEK: DeepSeek V3</option>
                                    <option value="QWEN:qwen-plus">QWEN: Qwen Plus</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">封面图生成</label>
                                <select name="IMAGE_GENERATOR_TYPE" class="config-input w-full p-2 text-sm border rounded-lg bg-white outline-none focus:ring-2 focus:ring-purple-500">
                                    <option value="QWEN_IMAGE_MAX">通义万相 (Max) - 效果最好</option>
                                    <option value="GEMINI">Gemini Imagen - 免费稳定</option>
                                    <option value="TEXT_LOGO">纯文本 Logo - 极简</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 mb-1">SINGLE_URL 专用模型</label>
                                <select name="SINGLE_URL_LLM_MODEL" class="config-input w-full p-2 text-sm border rounded-lg bg-white outline-none focus:ring-2 focus:ring-purple-500">
                                    <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
                                    <option value="gemini-1.5-flash">Gemini 1.5 Flash</option>
                                    <option value="gpt-4o">GPT-4o (中转/官方)</option>
                                    <option value="claude-3-5-sonnet-20241022">Claude 3.5 Sonnet</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="px-8 py-6 bg-gray-50 border-t flex items-center justify-between">
                <span id="config-save-status" class="text-sm font-medium transition-opacity opacity-0">✅ 已保存！</span>
                <button onclick="saveConfigs()" class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-100 hover:bg-blue-700 active:scale-95 transition-all">
                    保存并应用配置
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed top-24 left-1/2 transform -translate-x-1/2 z-50 hidden">
        <div class="bg-gray-800 text-white px-6 py-3 rounded-full shadow-2xl flex items-center space-x-3">
            <span id="toast-icon" class="text-blue-400"><i class="fas fa-info-circle"></i></span>
            <span id="toast-message" class="text-sm font-medium">消息通知</span>
        </div>
    </div>

    <!-- Refine Modal - Markdown Editor + Live Preview -->
    <div id="refine-modal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-50 backdrop-blur-sm">
        <div class="h-full w-full flex flex-col bg-white">
            <!-- Header -->
            <div class="px-6 py-4 border-b flex items-center justify-between bg-gradient-to-r from-purple-50 to-blue-50 shadow-sm">
                <div class="flex items-center space-x-6">
                    <div>
                        <h2 class="text-lg font-bold text-gray-800 flex items-center">
                            <i class="fas fa-edit text-purple-600 mr-2"></i> 全文 Markdown 编辑器
                        </h2>
                        <p class="text-xs text-gray-500 mt-0.5">直接修改全文 Markdown，右侧实时预览最终排版效果</p>
                    </div>
                    <!-- Quick Style Access in Modal -->
                    <div class="h-8 w-px bg-gray-200 mx-2"></div>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-2">
                            <span class="text-[10px] font-bold text-gray-400 uppercase">字号</span>
                            <div class="flex bg-white rounded-md border p-0.5">
                                <button onclick="updateStyle('fontSize', '14px')" class="style-btn-fontSize px-2 py-0.5 text-[10px] rounded hover:bg-gray-50" data-value="14px">14</button>
                                <button onclick="updateStyle('fontSize', '16px')" class="style-btn-fontSize px-2 py-0.5 text-[10px] rounded hover:bg-gray-50" data-value="16px">16</button>
                                <button onclick="updateStyle('fontSize', '18px')" class="style-btn-fontSize px-2 py-0.5 text-[10px] rounded hover:bg-gray-50" data-value="18px">18</button>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-[10px] font-bold text-gray-400 uppercase">主题色</span>
                            <div class="flex items-center space-x-1">
                                <button onclick="updateStyle('primaryColor', '#0F4C81')" class="style-btn-primaryColor w-4 h-4 rounded-full border border-white shadow-sm" style="background-color: #0F4C81" data-value="#0F4C81"></button>
                                <button onclick="updateStyle('primaryColor', '#009874')" class="style-btn-primaryColor w-4 h-4 rounded-full border border-white shadow-sm" style="background-color: #009874" data-value="#009874"></button>
                                <button onclick="updateStyle('primaryColor', '#FF6F61')" class="style-btn-primaryColor w-4 h-4 rounded-full border border-white shadow-sm" style="background-color: #FF6F61" data-value="#FF6F61"></button>
                                <button onclick="updateStyle('primaryColor', '#3f9cf5')" class="style-btn-primaryColor w-4 h-4 rounded-full border border-white shadow-sm" style="background-color: #3f9cf5" data-value="#3f9cf5"></button>
                            </div>
                        </div>
                    </div>
                </div>
                <button onclick="closeRefinePanel()" class="text-gray-400 hover:text-gray-600 bg-white px-4 py-2 rounded-lg shadow-sm hover:shadow transition-all">
                    <i class="fas fa-times mr-1"></i> 关闭
                </button>
            </div>

            <!-- Editor + Preview Split -->
            <div class="flex-1 flex overflow-hidden">
                <!-- Left Sidebar: Sections & Style -->
                <div class="w-64 bg-gray-50 border-r flex flex-col overflow-hidden flex-shrink-0">
                    <!-- Section Selector -->
                    <div class="p-4 border-b">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 flex items-center">
                            <i class="fas fa-list-ul mr-2"></i> 编辑区域选择
                        </h3>
                        <div id="section-list" class="space-y-2">
                            <button onclick="switchSection('full')" id="btn-section-full" class="section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all bg-purple-100 text-purple-700 font-bold border border-purple-200">
                                <i class="fas fa-file-alt mr-2"></i> 整篇文章
                            </button>
                            <button onclick="switchSection('introduction')" id="btn-section-introduction" class="section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all hover:bg-white hover:shadow-sm text-gray-600 border border-transparent">
                                <i class="fas fa-align-left mr-2"></i> 文章开头
                            </button>
                            <div id="article-sections" class="space-y-2 py-1">
                                <!-- Dynamic article sections here -->
                            </div>
                            <button onclick="switchSection('footer')" id="btn-section-footer" class="section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all hover:bg-white hover:shadow-sm text-gray-600 border border-transparent">
                                <i class="fas fa-quote-right mr-2"></i> 结语部分
                            </button>
                        </div>
                    </div>

                    <!-- Style Preview Configuration (Moved to bottom of sidebar) -->
                    <div class="p-4 flex-1 overflow-y-auto">
                        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 flex items-center">
                            <i class="fas fa-palette mr-2"></i> 样式预览配置
                        </h3>
                        
                        <div class="space-y-6">
                            <!-- Font Size -->
                            <div>
                                <label class="block text-[10px] font-bold text-gray-500 mb-2 uppercase">字号</label>
                                <div class="grid grid-cols-5 gap-1">
                                    <button onclick="updateStyle('fontSize', '14px')" class="style-btn-fontSize text-[10px] p-1 border rounded bg-white hover:bg-blue-50" data-value="14px">14</button>
                                    <button onclick="updateStyle('fontSize', '15px')" class="style-btn-fontSize text-[10px] p-1 border rounded bg-white hover:bg-blue-50" data-value="15px">15</button>
                                    <button onclick="updateStyle('fontSize', '16px')" class="style-btn-fontSize text-[10px] p-1 border rounded bg-white hover:bg-blue-50" data-value="16px">16</button>
                                    <button onclick="updateStyle('fontSize', '17px')" class="style-btn-fontSize text-[10px] p-1 border rounded bg-white hover:bg-blue-50" data-value="17px">17</button>
                                    <button onclick="updateStyle('fontSize', '18px')" class="style-btn-fontSize text-[10px] p-1 border rounded bg-white hover:bg-blue-50" data-value="18px">18</button>
                                </div>
                            </div>

                            <!-- Theme Color -->
                            <div>
                                <label class="block text-[10px] font-bold text-gray-500 mb-2 uppercase">主题色</label>
                                <div class="grid grid-cols-5 gap-2">
                                    <button onclick="updateStyle('primaryColor', '#0F4C81')" class="style-btn-primaryColor w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: #0F4C81" data-value="#0F4C81" title="经典蓝"></button>
                                    <button onclick="updateStyle('primaryColor', '#009874')" class="style-btn-primaryColor w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: #009874" data-value="#009874" title="翡翠绿"></button>
                                    <button onclick="updateStyle('primaryColor', '#FF6F61')" class="style-btn-primaryColor w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: #FF6F61" data-value="#FF6F61" title="珊瑚红"></button>
                                    <button onclick="updateStyle('primaryColor', '#6B5B95')" class="style-btn-primaryColor w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: #6B5B95" data-value="#6B5B95" title="葡萄紫"></button>
                                    <button onclick="updateStyle('primaryColor', '#3f9cf5')" class="style-btn-primaryColor w-6 h-6 rounded-full border-2 border-white shadow-sm" style="background-color: #3f9cf5" data-value="#3f9cf5" title="天空蓝"></button>
                                </div>
                            </div>

                            <!-- Font Family -->
                            <div>
                                <label class="block text-[10px] font-bold text-gray-500 mb-2 uppercase">字体风格</label>
                                <select onchange="updateStyle('fontFamily', this.value)" class="modal-font-family-select w-full p-2 text-[10px] border rounded bg-white outline-none focus:ring-1 focus:ring-blue-500">
                                    <option value="Optima-Regular, Optima, PingFangSC-light, PingFangSC-Regular, 'Helvetica Neue', Helvetica, Arial, sans-serif">无衬线 (系统默认)</option>
                                    <option value="Georgia, 'Nimbus Roman No9 L', 'Songti SC', 'Noto Serif CJK SC', 'Source Serif Pro', 'AR PL New Sung', 'AR PL Sumti', 'STSong', 'SimSun', serif">衬线 (优雅经典)</option>
                                    <option value="Menlo, Monaco, Consolas, 'Courier New', monospace">等宽 (程序员风)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Middle: Markdown Editor -->
                <div class="flex-1 flex flex-col border-r bg-gray-50 overflow-hidden">
                    <div class="px-4 py-3 bg-white border-b flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="text-sm font-semibold text-gray-700">📄 Markdown 源码</span>
                            <span class="text-xs text-gray-400" id="markdown-char-count">0 字符</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="undoMarkdown()" class="px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 rounded" title="撤销">
                                <i class="fas fa-undo"></i>
                            </button>
                            <button onclick="redoMarkdown()" class="px-2 py-1 text-xs text-gray-600 hover:bg-gray-100 rounded" title="重做">
                                <i class="fas fa-redo"></i>
                            </button>
                        </div>
                    </div>
                    <textarea 
                        id="markdown-editor" 
                        class="flex-1 p-6 font-mono text-sm leading-relaxed resize-none outline-none bg-white"
                        placeholder="在此输入或编辑 Markdown 内容..."
                        oninput="onMarkdownChange()"
                        onscroll="syncScroll()"
                        spellcheck="false"
                    ></textarea>
                </div>

                <!-- Right: Live Preview -->
                <div class="flex-1 flex flex-col bg-white overflow-hidden">
                    <div class="px-4 py-3 bg-white border-b flex items-center justify-between">
                        <span class="text-sm font-semibold text-gray-700">👁️ 实时预览</span>
                        <select id="preview-render-mode" onchange="renderMarkdownPreview()" class="px-2 py-1 text-xs border rounded">
                            <option value="default">Doocs: 默认 (Classic)</option>
                            <option value="elegant">Doocs: 优雅 (Elegant)</option>
                            <option value="simple">Doocs: 简约 (Simple)</option>
                            <option value="raw">Raw: 简单渲染</option>
                        </select>
                    </div>
                    <div id="markdown-preview" class="flex-1 overflow-y-auto p-6 prose prose-sm max-w-none" onscroll="syncScrollFromPreview()">
                        <p class="text-gray-400 text-center mt-10">预览区域</p>
                    </div>
                </div>
            </div>

            <!-- Footer: AI Tools + Actions -->
            <div class="px-6 py-4 bg-gray-50 border-t flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <span class="text-xs font-semibold text-gray-600">🤖 AI 助手:</span>
                    <select id="selected-model" class="px-3 py-1.5 text-xs border rounded-lg bg-white">
                        <option value="DEEPSEEK:deepseek-chat">DeepSeek (推理强)</option>
                        <option value="QWEN:qwen-plus">Qwen Plus (平衡)</option>
                        <option value="GEMINI:gemini-flash-lite-latest">Gemini Lite (极速)</option>
                        <option value="CLAUDE:claude-3-5-sonnet-20241022">Claude Sonnet (优雅)</option>
                    </select>
                    <input 
                        type="text" 
                        id="refine-instruction" 
                        placeholder="输入修改指令，例如：增加技术细节、改为通俗语言..." 
                        class="px-3 py-1.5 text-xs border rounded-lg w-80 outline-none focus:ring-2 focus:ring-purple-400"
                    />
                    <button onclick="executeAIRefine()" class="px-4 py-1.5 bg-purple-600 text-white text-xs font-bold rounded-lg hover:bg-purple-700 transition-all">
                        <i class="fas fa-wand-magic-sparkles mr-1"></i> AI 润色
                    </button>
                </div>
                <div class="flex items-center space-x-3">
                    <span id="refine-status" class="text-xs text-gray-500"></span>
                    <button onclick="saveMarkdownChanges()" class="px-6 py-2 bg-green-600 text-white text-sm font-bold rounded-lg hover:bg-green-700 transition-all">
                        <i class="fas fa-save mr-2"></i> 保存修改
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentMode = 'TECH_NEWS';
        let isRunning = false;

        // --- Style & Theme Support ---
        let themeState = {
            fontSize: localStorage.getItem('md-size') || '16px',
            primaryColor: localStorage.getItem('md-color') || '#3f9cf5',
            fontFamily: localStorage.getItem('md-fonts') || "Optima-Regular, Optima, PingFangSC-light, PingFangSC-Regular, 'Helvetica Neue', Helvetica, Arial, sans-serif"
        };

        function applyTheme() {
            const styleEl = document.getElementById('md-theme-variables');
            if (!styleEl) return;

            const css = `
                :root {
                    --md-primary-color: ${themeState.primaryColor};
                    --md-font-family: ${themeState.fontFamily};
                    --md-font-size: ${themeState.fontSize};
                }
                #preview-content, #markdown-preview {
                    font-family: var(--md-font-family) !important;
                    font-size: var(--md-font-size) !important;
                }
                #preview-content h1, #preview-content h2, #preview-content h3,
                #markdown-preview h1, #markdown-preview h2, #markdown-preview h3 {
                    color: var(--md-primary-color) !important;
                }
            `;
            styleEl.textContent = css;

            // 更新 UI 状态
            document.querySelectorAll('.style-btn-fontSize').forEach(btn => {
                btn.classList.toggle('bg-blue-600', btn.getAttribute('data-value') === themeState.fontSize);
                btn.classList.toggle('text-white', btn.getAttribute('data-value') === themeState.fontSize);
            });
            document.querySelectorAll('.style-btn-primaryColor').forEach(btn => {
                btn.classList.toggle('ring-2', btn.getAttribute('data-value') === themeState.primaryColor);
                btn.classList.toggle('ring-offset-1', btn.getAttribute('data-value') === themeState.primaryColor);
                btn.classList.toggle('ring-blue-500', btn.getAttribute('data-value') === themeState.primaryColor);
            });
            const familySelect = document.getElementById('font-family-select');
            if (familySelect) familySelect.value = themeState.fontFamily;
            
            // 同步模态框内的字体选择器
            document.querySelectorAll('.modal-font-family-select').forEach(s => {
                s.value = themeState.fontFamily;
            });

            // 持久化
            localStorage.setItem('md-size', themeState.fontSize);
            localStorage.setItem('md-color', themeState.primaryColor);
            localStorage.setItem('md-fonts', themeState.fontFamily);
        }

        function updateStyle(key, value) {
            themeState[key] = value;
            applyTheme();
        }

        // --- Mermaid Setup ---
        const svgCache = new Map();
        
        async function initMermaid() {
            if (window.mermaid) {
                window.mermaid.initialize({
                    startOnLoad: false,
                    theme: 'default',
                    securityLevel: 'loose',
                    fontFamily: 'Inter, sans-serif'
                });
            }
        }

        async function renderMermaidDiagrams(containerId) {
            const container = document.getElementById(containerId);
            if (!container || !window.mermaid) return;

            const diagrams = container.querySelectorAll('.mermaid-diagram');
            for (const el of diagrams) {
                const code = decodeURIComponent(el.getAttribute('data-mermaid-code'));
                const cacheKey = el.id.replace('mermaid-', '');
                
                if (svgCache.has(cacheKey)) {
                    el.innerHTML = svgCache.get(cacheKey);
                    continue;
                }

                try {
                    const { svg } = await window.mermaid.render(`svg-${cacheKey}`, code);
                    // 修复 mermaid SVG 中 tspan 文本颜色问题 (由用户提供)
                    const fixedSvg = svg.replace(/<tspan([^>]*)>/g, '<tspan$1 style="fill: #333333 !important; stroke: none !important;">');
                    svgCache.set(cacheKey, fixedSvg);
                    el.innerHTML = fixedSvg;
                } catch (error) {
                    console.error('Mermaid 渲染失败:', error);
                    el.innerHTML = `<div class="p-2 border border-red-200 bg-red-50 text-red-600 text-xs rounded">Mermaid 渲染失败: ${error.message}</div>`;
                }
            }
        }

        async function renderPlantUMLDiagrams(containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;

            const diagrams = container.querySelectorAll('.plantuml-diagram');
            for (const el of diagrams) {
                const isInline = el.getAttribute('data-plantuml-inline') === 'true';
                if (!isInline) continue;

                const url = el.getAttribute('data-plantuml-url');
                const cacheKey = el.id.replace('plantuml-', '');

                if (svgCache.has(cacheKey)) {
                    el.innerHTML = svgCache.get(cacheKey);
                    continue;
                }

                try {
                    const response = await fetch(url);
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    let svg = await response.text();
                    
                    // 移除固定尺寸，使 SVG 响应式
                    svg = svg.replace(/(<svg[^>]*)\swidth="[^"]*"/g, '$1')
                             .replace(/(<svg[^>]*)\sheight="[^"]*"/g, '$1');
                    
                    svgCache.set(cacheKey, svg);
                    el.innerHTML = svg;
                } catch (error) {
                    console.error('PlantUML 渲染失败:', error);
                    // 保持原有的 <img> 标签作为降级
                }
            }
        }

        // --- Core Functions ---

        async function rpc(method, params = {}) {
            const res = await fetch('/api/workflow', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ jsonrpc: '2.0', method, params, id: Date.now() })
            });
            const data = await res.json();
            if (data.error) throw new Error(data.error.message || 'RPC Error');
            return data.result;
        }

        function setMode(mode) {
            currentMode = mode;
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50', 'bg-purple-50', 'bg-orange-50', 'bg-green-50');
                btn.classList.add('border-transparent');
            });
            
            const btn = document.getElementById(`mode-${mode}`);
            btn.classList.add('ring-2');
            if (mode === 'TECH_NEWS') btn.classList.add('ring-blue-500', 'bg-blue-50');
            if (mode === 'GITHUB_TRENDING') btn.classList.add('ring-purple-500', 'bg-purple-50');
            if (mode === 'SINGLE_URL') btn.classList.add('ring-orange-500', 'bg-orange-50');
            if (mode === 'TOP_SEARCH') btn.classList.add('ring-green-500', 'bg-green-50');

            document.getElementById('param-url').classList.toggle('hidden', mode !== 'SINGLE_URL');
            document.getElementById('param-topic').classList.toggle('hidden', mode !== 'TOPIC_SEARCH');
        }

        function updateWordRange() {
            const min = document.getElementById('min-words').value;
            const max = document.getElementById('max-words').value;
            document.getElementById('word-range-val').innerText = `${min} - ${max}`;
        }

        async function runWorkflow() {
            if (isRunning) return;
            
            try {
                isRunning = true;
                document.getElementById('run-btn').disabled = true;
                document.getElementById('run-btn').classList.add('opacity-50');
                document.getElementById('running-status').classList.remove('hidden');
                clearLogs();
                appendLog('[系统]', '正在启动工作流...', 'log-info');

                const params = {
                    workflowType: 'weixin-article-workflow',
                    contentMode: currentMode,
                    maxArticles: parseInt(document.getElementById('max-articles').value),
                    minWords: parseInt(document.getElementById('min-words').value),
                    maxWords: parseInt(document.getElementById('max-words').value),
                    template: document.getElementById('article-template').value,
                    customFooter: document.getElementById('custom-footer').value,
                    previewOnly: true // 始终先预览
                };

                if (currentMode === 'SINGLE_URL') params.url = document.getElementById('url-input').value;
                if (currentMode === 'TOPIC_SEARCH') params.topic = document.getElementById('topic-input').value;

                await rpc('triggerWorkflow', params);
                appendLog('[系统]', '工作流触发成功，正在处理内容...', 'log-info');
                
                // 开始定时轮询预览结果
                checkPreviewInterval = setInterval(async () => {
                    const preview = await rpc('getArticlePreview');
                    if (preview) {
                        clearInterval(checkPreviewInterval);
                        showPreview(preview);
                        resetRunButton();
                    }
                }, 3000);

            } catch (error) {
                appendLog('[错误]', error.message, 'log-error');
                resetRunButton();
            }
        }

        let checkPreviewInterval;

        function resetRunButton() {
            isRunning = false;
            document.getElementById('run-btn').disabled = false;
            document.getElementById('run-btn').classList.remove('opacity-50');
            document.getElementById('running-status').classList.add('hidden');
        }

        let currentPreview = null;

        function showPreview(preview) {
            currentPreview = preview;
            document.getElementById('preview-content').innerHTML = preview.html;
            renderMermaidDiagrams('preview-content');
            renderPlantUMLDiagrams('preview-content');

            // 同步预览区模板选择
            const mainTemplate = document.getElementById('article-template').value;
            const previewTemplate = document.getElementById('preview-template');
            if (previewTemplate) previewTemplate.value = mainTemplate;
            
            const container = document.getElementById('preview-container');
            container.classList.remove('hidden');
            setTimeout(() => container.classList.remove('translate-x-full'), 10);
            showToast('预览已生成，请检查');
        }

        function syncTemplateFromPreview() {
            const previewTemplate = document.getElementById('preview-template').value;
            const mainTemplate = document.getElementById('article-template');
            if (mainTemplate) {
                mainTemplate.value = previewTemplate;
            }
            tryUpdatePreview();
        }

        async function tryUpdatePreview() {
            // 如果预览容器不是隐藏状态，说明预览正在显示，此时才更新
            const container = document.getElementById('preview-container');
            if (container.classList.contains('hidden')) return;

            try {
                const template = document.getElementById('article-template').value;
                const customFooter = document.getElementById('custom-footer').value;

                const previewTemplate = document.getElementById('preview-template');
                if (previewTemplate) previewTemplate.value = template;
                
                showToast('正在应用新模板...', 'info');
                const updated = await rpc('updatePreview', { template, customFooter });
                document.getElementById('preview-content').innerHTML = updated.html;
                renderMermaidDiagrams('preview-content');
                renderPlantUMLDiagrams('preview-content');
                showToast('预览已更新', 'success');
            } catch (error) {
                showToast('更新预览失败: ' + error.message, 'error');
            }
        }

        // --- Markdown Editor Functions ---
        
        let markdownHistory = [];
        let historyIndex = -1;
        let debounceTimer = null;
        let currentSection = { type: 'full', index: null };

        function openRefinePanel() {
            if (!currentPreview) {
                showToast('请先生成预览', 'error');
                return;
            }
            document.getElementById('refine-modal').classList.remove('hidden');
            
            // 初始化区域列表
            updateSectionList();
            
            // 默认打开整篇文章
            switchSection('full');
        }

        function updateSectionList() {
            const container = document.getElementById('article-sections');
            container.innerHTML = '';
            
            if (currentPreview.articles && currentPreview.articles.length > 0) {
                currentPreview.articles.forEach((article, idx) => {
                    const btn = document.createElement('button');
                    btn.id = `btn-section-article-${idx}`;
                    btn.onclick = () => switchSection('article', idx);
                    btn.className = 'section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all hover:bg-white hover:shadow-sm text-gray-600 border border-transparent';
                    btn.innerHTML = `<i class="fas fa-newspaper mr-2 text-xs opacity-70"></i> 子文章 ${idx + 1}`;
                    container.appendChild(btn);
                });
            }
        }

        function switchSection(type, index = null) {
            // 保存当前正在编辑的内容（可选，或者提示用户保存）
            
            currentSection = { type, index };
            
            // 更新 UI 样式
            document.querySelectorAll('.section-btn').forEach(btn => {
                btn.className = 'section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all hover:bg-white hover:shadow-sm text-gray-600 border border-transparent';
            });
            
            let btnId = `btn-section-${type}`;
            if (type === 'article') btnId = `btn-section-article-${index}`;
            
            const activeBtn = document.getElementById(btnId);
            if (activeBtn) {
                activeBtn.className = 'section-btn w-full text-left p-2.5 rounded-lg text-sm transition-all bg-purple-100 text-purple-700 font-bold border border-purple-200';
            }
            
            // 加载内容
            const editor = document.getElementById('markdown-editor');
            let content = '';
            
            if (type === 'full') {
                content = currentPreview.markdown || '';
            } else if (type === 'introduction') {
                content = currentPreview.introduction || '';
            } else if (type === 'footer') {
                content = currentPreview.footer || '';
            } else if (type === 'article' && index !== null) {
                content = currentPreview.articles[index].content || '';
                // 如果子文章有标题，尝试在编辑区也显示 ## 标题（仅展示，保存时会剥离）
                if (currentPreview.articles[index].title) {
                    content = `## ${currentPreview.articles[index].title}\n\n${content}`;
                }
            }
            
            editor.value = content;
            markdownHistory = [content];
            historyIndex = 0;
            renderMarkdownPreview();
            updateCharCount();
            
            // 更新标题提示
            const headerTitle = document.querySelector('#refine-modal h2');
            const typeLabels = { 'full': '全文 Markdown', 'introduction': '文章开头', 'article': `子文章 ${index + 1}`, 'footer': '结语部分' };
            headerTitle.innerHTML = `<i class="fas fa-edit text-purple-600 mr-2"></i> ${typeLabels[type]} 编辑器`;
        }

        async function renderMarkdownPreview() {
            const editor = document.getElementById('markdown-editor');
            const preview = document.getElementById('markdown-preview');
            const mode = document.getElementById('preview-render-mode').value;
            
            const markdown = editor.value;
            
            if (!markdown.trim()) {
                preview.innerHTML = '<p class="text-gray-400 text-center mt-10">预览区域</p>';
                return;
            }
            
            try {
                if (mode !== 'raw') {
                    // 调用后端 Doocs MD 渲染
                    // 如果是子部分，我们需要包装一下以便显示大致预览效果
                    let renderContent = markdown;
                    
                    const result = await rpc('renderMarkdown', { 
                        markdown: renderContent,
                        template: mode
                    });
                    preview.innerHTML = result.html;
                    renderMermaidDiagrams('markdown-preview');
                    renderPlantUMLDiagrams('markdown-preview');
                } else {
                    preview.innerHTML = simpleMarkdownRender(markdown);
                }
            } catch (error) {
                preview.innerHTML = `<p class="text-red-500 text-sm p-4">渲染失败: ${error.message}</p>`;
            }
        }

        async function executeAIRefine() {
            const instruction = document.getElementById('refine-instruction').value.trim();
            const llmProvider = document.getElementById('selected-model').value;
            const editor = document.getElementById('markdown-editor');
            
            if (!instruction) {
                showToast('请输入修改指令', 'error');
                return;
            }

            try {
                const status = document.getElementById('refine-status');
                status.textContent = `⏳ AI 正在${currentSection.type === 'full' ? '全文' : '当前区域'}打磨中...`;
                
                const params = {
                    sectionType: currentSection.type,
                    sectionIndex: currentSection.index,
                    currentContent: editor.value,
                    userInstruction: instruction,
                    llmProvider,
                };

                const result = await rpc('refineContent', params);
                
                // 注意：后端 refineContent 应该返回更新后的预览对象
                currentPreview = result;
                
                // 重新加载当前区域的内容到编辑器
                switchSection(currentSection.type, currentSection.index);
                
                showToast('✨ AI 打磨完成', 'success');
                status.textContent = '✅ 打磨完成，可继续编辑或保存';
                
            } catch (error) {
                showToast('打磨失败: ' + error.message, 'error');
                document.getElementById('refine-status').textContent = '❌ 打磨失败';
            }
        }

        async function saveMarkdownChanges() {
            const editor = document.getElementById('markdown-editor');
            const content = editor.value;
            
            try {
                const status = document.getElementById('refine-status');
                status.textContent = '💾 正在保存...';
                
                let result;
                if (currentSection.type === 'full') {
                    result = await rpc('updateFullMarkdown', { markdown: content });
                } else {
                    result = await rpc('updateMarkdownContent', {
                        sectionType: currentSection.type,
                        sectionIndex: currentSection.index,
                        markdown: content
                    });
                }
                
                currentPreview = result;
                // 更新全局预览背景页
                document.getElementById('preview-content').innerHTML = result.html;
                renderMermaidDiagrams('preview-content');
                renderPlantUMLDiagrams('preview-content');
                
                // 如果当前编辑的是文章，可能更新了标题，需要刷新区域列表
                if (currentSection.type === 'article') {
                    updateSectionList();
                }
                
                showToast('✅ 保存成功，预览已同步', 'success');
                status.textContent = '✅ 已保存';
                
                setTimeout(() => { status.textContent = ''; }, 2000);
                
            } catch (error) {
                showToast('保存失败: ' + error.message, 'error');
                document.getElementById('refine-status').textContent = '❌ 保存失败';
            }
        }

        function closeRefinePanel() {
            document.getElementById('refine-modal').classList.add('hidden');
            document.getElementById('refine-instruction').value = '';
            document.getElementById('refine-status').textContent = '';
            markdownHistory = [];
            historyIndex = -1;
        }

        function onMarkdownChange() {
            const editor = document.getElementById('markdown-editor');
            const content = editor.value;
            
            // 添加到历史记录
            if (content !== markdownHistory[historyIndex]) {
                markdownHistory = markdownHistory.slice(0, historyIndex + 1);
                markdownHistory.push(content);
                historyIndex++;
                
                // 限制历史记录数量
                if (markdownHistory.length > 50) {
                    markdownHistory.shift();
                    historyIndex--;
                }
            }
            
            updateCharCount();
            
            // 防抖渲染
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                renderMarkdownPreview();
            }, 300);
        }

        function updateCharCount() {
            const editor = document.getElementById('markdown-editor');
            const count = editor.value.length;
            document.getElementById('markdown-char-count').textContent = `${count} 字符`;
        }

        let isSyncingScroll = false;

        function syncScroll() {
            if (isSyncingScroll) return;
            const editor = document.getElementById('markdown-editor');
            const preview = document.getElementById('markdown-preview');
            if (!editor || !preview) return;

            isSyncingScroll = true;
            const maxEditorScroll = editor.scrollHeight - editor.clientHeight;
            const maxPreviewScroll = preview.scrollHeight - preview.clientHeight;
            const scrollPercentage = maxEditorScroll > 0 ? (editor.scrollTop / maxEditorScroll) : 0;
            preview.scrollTop = scrollPercentage * maxPreviewScroll;
            isSyncingScroll = false;
        }

        function syncScrollFromPreview() {
            if (isSyncingScroll) return;
            const editor = document.getElementById('markdown-editor');
            const preview = document.getElementById('markdown-preview');
            if (!editor || !preview) return;

            isSyncingScroll = true;
            const maxPreviewScroll = preview.scrollHeight - preview.clientHeight;
            const maxEditorScroll = editor.scrollHeight - editor.clientHeight;
            const scrollPercentage = maxPreviewScroll > 0 ? (preview.scrollTop / maxPreviewScroll) : 0;
            editor.scrollTop = scrollPercentage * maxEditorScroll;
            isSyncingScroll = false;
        }

        function undoMarkdown() {
            if (historyIndex > 0) {
                historyIndex--;
                const editor = document.getElementById('markdown-editor');
                editor.value = markdownHistory[historyIndex];
                renderMarkdownPreview();
                updateCharCount();
            }
        }

        function redoMarkdown() {
            if (historyIndex < markdownHistory.length - 1) {
                historyIndex++;
                const editor = document.getElementById('markdown-editor');
                editor.value = markdownHistory[historyIndex];
                renderMarkdownPreview();
                updateCharCount();
            }
        }

        function simpleMarkdownRender(markdown) {
            // 简单的 Markdown 渲染（基础支持）
            let html = markdown
                // 标题
                .replace(/^### (.*$)/gim, '<h3 class="text-lg font-bold mt-4 mb-2">$1</h3>')
                .replace(/^## (.*$)/gim, '<h2 class="text-xl font-bold mt-6 mb-3">$1</h2>')
                .replace(/^# (.*$)/gim, '<h1 class="text-2xl font-bold mt-8 mb-4">$1</h1>')
                // 加粗
                .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold">$1</strong>')
                // 斜体
                .replace(/\*(.*?)\*/g, '<em class="italic">$1</em>')
                // 代码块
                .replace(/```(.*?)```/gs, '<pre class="bg-gray-100 p-3 rounded my-2 overflow-x-auto"><code>$1</code></pre>')
                // 行内代码
                .replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1 rounded text-sm">$1</code>')
                // 链接
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-blue-600 hover:underline">$1</a>')
                // 图片
                .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" class="max-w-full my-4 rounded" />')
                // 分隔线
                .replace(/^---$/gm, '<hr class="my-6 border-gray-300" />')
                // 段落
                .replace(/\n\n/g, '</p><p class="mb-4">')
                // 换行
                .replace(/\n/g, '<br />');
            
            return `<div class="markdown-body p-4">${html}</div>`;
        }

        function closePreview() {
            const container = document.getElementById('preview-container');
            container.classList.add('translate-x-full');
            setTimeout(() => container.classList.add('hidden'), 300);
        }

        async function publishArticle() {
            try {
                const btn = document.getElementById('publish-btn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> 发布中...';
                
                await rpc('confirmPublish');
                
                showToast('🎉 发布成功！已上传至微信草稿箱', 'success');
                closePreview();
            } catch (error) {
                showToast('发布失败: ' + error.message, 'error');
            } finally {
                const btn = document.getElementById('publish-btn');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-cloud-upload-alt mr-2"></i> 确认发布到公众号';
            }
        }

        // --- Config ---

        // API Source Tab 切换（官方 vs 中转）
        function switchApiSourceTab(source) {
            // 更新隐藏字段
            document.getElementById('api-source-type-input').value = source;
            
            // 更新标签样式
            const officialTab = document.getElementById('tab-official');
            const proxyTab = document.getElementById('tab-proxy');
            
            if (source === 'official') {
                officialTab.classList.add('bg-white', 'shadow-md', 'text-blue-600');
                officialTab.classList.remove('text-gray-500', 'hover:bg-gray-50');
                proxyTab.classList.remove('bg-white', 'shadow-md', 'text-purple-600');
                proxyTab.classList.add('text-gray-500', 'hover:bg-gray-50');
                
                // 显示/隐藏面板
                document.getElementById('official-config-panel').classList.remove('hidden');
                document.getElementById('proxy-config-panel').classList.add('hidden');
            } else {
                proxyTab.classList.add('bg-white', 'shadow-md', 'text-purple-600');
                proxyTab.classList.remove('text-gray-500', 'hover:bg-gray-50');
                officialTab.classList.remove('bg-white', 'shadow-md', 'text-blue-600');
                officialTab.classList.add('text-gray-500', 'hover:bg-gray-50');
                
                // 显示/隐藏面板
                document.getElementById('proxy-config-panel').classList.remove('hidden');
                document.getElementById('official-config-panel').classList.add('hidden');
            }
        }

        // 阿里云区域切换
        function selectAliyunRegion(region) {
            // 更新隐藏的 input 值
            document.getElementById('dashscope-region-input').value = region;
            
            // 更新按钮样式
            const cnBtn = document.getElementById('aliyun-region-cn');
            const intlBtn = document.getElementById('aliyun-region-intl');
            
            if (region === 'cn') {
                cnBtn.classList.remove('border-gray-300');
                cnBtn.classList.add('border-orange-500', 'bg-orange-100', 'shadow-md');
                intlBtn.classList.remove('border-orange-500', 'bg-orange-100', 'shadow-md');
                intlBtn.classList.add('border-gray-300');
                
                // 更新标签
                document.getElementById('aliyun-api-key-label').textContent = '阿里云 API Key (国内版)';
                document.getElementById('aliyun-api-key-hint').innerHTML = '💡 此密钥将用于通义千问文本模型和通义万相图片模型<br><span class="text-orange-600 font-semibold">Base URL: https://dashscope.aliyuncs.com/compatible-mode/v1</span>';
            } else {
                intlBtn.classList.remove('border-gray-300');
                intlBtn.classList.add('border-orange-500', 'bg-orange-100', 'shadow-md');
                cnBtn.classList.remove('border-orange-500', 'bg-orange-100', 'shadow-md');
                cnBtn.classList.add('border-gray-300');
                
                // 更新标签
                document.getElementById('aliyun-api-key-label').textContent = '阿里云 API Key (国际版)';
                document.getElementById('aliyun-api-key-hint').innerHTML = '💡 此密钥将用于通义千问文本模型和通义万相图片模型<br><span class="text-orange-600 font-semibold">Base URL: https://dashscope-intl.aliyuncs.com/compatible-mode/v1</span>';
            }
        }

        // 国际 AI 服务 API 来源切换
        function selectApiSource(source) {
            // 更新隐藏的 input 值
            document.getElementById('api-source-input').value = source;
            
            // 更新按钮样式
            const officialBtn = document.getElementById('api-source-official');
            const proxyBtn = document.getElementById('api-source-proxy');
            
            // 获取配置区域
            const officialConfig = document.getElementById('official-api-config');
            const proxyConfig = document.getElementById('proxy-api-config');
            
            if (source === 'official') {
                // 官方 API - 高亮官方按钮
                officialBtn.classList.remove('border-gray-300');
                officialBtn.classList.add('border-blue-500', 'bg-blue-100', 'shadow-md');
                proxyBtn.classList.remove('border-blue-500', 'bg-blue-100', 'shadow-md');
                proxyBtn.classList.add('border-gray-300');
                
                // 显示官方配置，隐藏代理配置
                officialConfig.classList.remove('hidden');
                proxyConfig.classList.add('hidden');
            } else {
                // 中间服务 API - 高亮代理按钮
                proxyBtn.classList.remove('border-gray-300');
                proxyBtn.classList.add('border-blue-500', 'bg-blue-100', 'shadow-md');
                officialBtn.classList.remove('border-blue-500', 'bg-blue-100', 'shadow-md');
                officialBtn.classList.add('border-gray-300');
                
                // 显示代理配置，隐藏官方配置
                proxyConfig.classList.remove('hidden');
                officialConfig.classList.add('hidden');
            }
        }

        async function toggleConfig() {
            const modal = document.getElementById('config-modal');
            const isHidden = modal.classList.toggle('hidden');
            if (!isHidden) {
                const configs = await rpc('getEnvConfig');
                Object.entries(configs).forEach(([key, val]) => {
                    const field = document.querySelector(`[name="${key}"]`);
                    if (field) field.value = val;
                });
                
                // 根据加载的 DASHSCOPE_REGION 初始化区域选择器
                const region = configs.DASHSCOPE_REGION || 'cn';
                selectAliyunRegion(region);
                
                // 根据加载的 API_SOURCE_TYPE 切换标签
                const apiSource = configs.API_SOURCE_TYPE || 'official';
                switchApiSourceTab(apiSource);
            }
        }

        async function saveConfigs() {
            const formData = new FormData(document.getElementById('config-form'));
            const params = {};
            formData.forEach((val, key) => params[key] = val);
            
            try {
                await rpc('saveEnvConfig', params);
                const status = document.getElementById('config-save-status');
                status.classList.remove('opacity-0');
                setTimeout(() => status.classList.add('opacity-0'), 2000);
                showToast('配置已持久化，部分设置可能需要重启生效');
            } catch (error) {
                alert('保存失败: ' + error.message);
            }
        }

        // --- Logs (SSE) ---

        function setupLogs() {
            const terminal = document.getElementById('terminal');
            const eventSource = new EventSource('/api/logs');
            
            eventSource.onmessage = (event) => {
                const log = JSON.parse(event.data);
                let type = 'log-info';
                if (log.includes('[ERROR]')) type = 'log-error';
                if (log.includes('[WARN]')) type = 'log-warn';
                
                const parts = log.match(/^\[(.*?)\] (.*)$/);
                if (parts) {
                    appendLog(parts[1], parts[2], type);
                } else {
                    appendLog('', log, type);
                }
            };

            eventSource.onerror = () => {
                document.getElementById('connection-status').innerHTML = '<span class="w-2 h-2 bg-red-500 rounded-full mr-2"></span> 服务已断开';
                document.getElementById('connection-status').className = 'flex items-center text-xs text-red-500 font-medium';
            };
        }

        function appendLog(timestamp, message, typeClass) {
            const terminal = document.getElementById('terminal');
            const div = document.createElement('div');
            div.className = 'log-entry';
            div.innerHTML = `<span class="log-timestamp">${timestamp}</span><span class="${typeClass}">${message}</span>`;
            terminal.appendChild(div);
            terminal.scrollTop = terminal.scrollHeight;
        }

        function clearLogs() {
            document.getElementById('terminal').innerHTML = '';
        }

        function showToast(msg, type = 'info') {
            const toast = document.getElementById('toast');
            const message = document.getElementById('toast-message');
            const icon = document.getElementById('toast-icon');
            
            message.innerText = msg;
            icon.innerHTML = type === 'success' ? '<i class="fas fa-check-circle text-green-400"></i>' : 
                            type === 'error' ? '<i class="fas fa-exclamation-circle text-red-400"></i>' : 
                            '<i class="fas fa-info-circle text-blue-400"></i>';
            
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }

        // Init
        setMode('TECH_NEWS');
        updateWordRange();
        setupLogs();
        initMermaid();
        applyTheme();
    </script>
</body>
</html>
