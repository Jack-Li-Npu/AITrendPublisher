{
  "nodeModulesDir": "auto",
  "npmRegistry": "https://registry.npmjs.org/",
  "tasks": {
    "start": "deno run -A --env-file=.env src/index.ts",
    "test": "deno run -A --env-file=.env src/test.ts",
    "test:gemini": "deno run -A --env-file=.env src/providers/llm/tests/gemini-llm.test.ts",
    "test:firecrawl": "deno run -A --env-file=.env src/modules/scrapers/tests/fireCrawl.scraper.test.ts",
    "build:win": "deno compile -A --target x86_64-pc-windows-msvc --output TrendPublish.exe --icon ./docs/images/main.ico --include public src/index.ts",
    "build:mac-x64": "deno compile -A --target x86_64-apple-darwin --output TrendPublish-mac-x64 --include public src/index.ts",
    "build:mac-arm64": "deno compile -A --target aarch64-apple-darwin --output TrendPublish-mac-arm64 --include public src/index.ts",
    "build:linux-x64": "deno compile -A --target x86_64-unknown-linux-gnu --output TrendPublish-linux-x64 --include public src/index.ts",
    "build:linux-arm64": "deno compile -A --target aarch64-unknown-linux-gnu --output TrendPublish-linux-arm64 --include public src/index.ts",
    "build:all": "deno task build:win && deno task build:mac-x64 && deno task build:mac-arm64 && deno task build:linux-x64 && deno task build:linux-arm64",
    "build:docs": "deno run --allow-all scripts/md2html.ts"
  },
  "imports": {
    "@deno-library/progress": "jsr:@deno-library/progress@^1.5.1",
    "@std/assert": "jsr:@std/assert@1",
    "@src/": "./src/",
    "@zilla/logger": "jsr:@zilla/logger@^1.0.1",
    "drizzle-kit": "npm:drizzle-kit@^0.30.5",
    "drizzle-orm": "npm:drizzle-orm@^0.40.0",
    "mysql2": "npm:mysql2@^3.13.0",
    "marked": "npm:marked@^17.0.1",
    "reading-time": "npm:reading-time@^1.5.0",
    "front-matter": "npm:front-matter@^4.0.2",
    "highlight.js": "npm:highlight.js@^11.11.1",
    "isomorphic-dompurify": "npm:isomorphic-dompurify@^2.34.0",
    "fflate": "npm:fflate@^0.8.2",
    "es-toolkit": "npm:es-toolkit@^1.42.0",
    "mermaid": "npm:mermaid@^11.12.2",
    "postcss": "npm:postcss@^8.5.6",
    "postcss-calc": "npm:postcss-calc@^10.1.1",
    "postcss-custom-properties": "npm:postcss-custom-properties@^14.0.6",
    "node-cron": "npm:node-cron@^3.0.3",
    "axios": "npm:axios@^1.7.0",
    "cheerio": "npm:cheerio@^1.0.0",
    "fast-xml-parser": "npm:fast-xml-parser@^4.5.0",
    "lru-cache": "npm:lru-cache@^11.0.0",
    "openai": "npm:openai@^4.70.0",
    "zod": "npm:zod@^3.24.0",
    "juice": "npm:juice@^11.0.0",
    "sharp": "npm:sharp@^0.33.0"
  },
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "unstable": ["sloppy-imports"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "public"
  ],
  "lint": {
    "exclude": [
    ],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "require-await"
      ]
    }
  },
  "allowScripts": {
    "allow": ["npm:sharp@0.33.5"],
    "deny": ["npm:esbuild@0.18.20", "npm:esbuild@0.19.12"]
  }
}