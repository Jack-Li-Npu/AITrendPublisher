# ============================================
# DeepSeek 快速配置模板
# ============================================
# 复制本文件内容到项目根目录的 .env 文件
# 替换 API Key 即可使用
#
# 特点：
# - 成本极低（0.001 元/千 tokens）
# - 速度快
# - 质量高
# - 适合个人使用、高频发布
# ============================================

# DeepSeek API 配置
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ⚠️ 替换为您的 API Key
DEEPSEEK_MODEL="deepseek-chat"

# 全局默认：使用 DeepSeek
DEFAULT_LLM_PROVIDER="DEEPSEEK"

# 内容排序：使用 DeepSeek Chat（快速判断）
AI_CONTENT_RANKER_LLM_PROVIDER="DEEPSEEK:deepseek-chat"

# 内容总结：使用 DeepSeek Chat（生成文章）
AI_SUMMARIZER_LLM_PROVIDER="DEEPSEEK:deepseek-chat"

# 单 URL 转载：使用 DeepSeek Chat
SINGLE_URL_LLM_PROVIDER="DEEPSEEK:deepseek-chat"
