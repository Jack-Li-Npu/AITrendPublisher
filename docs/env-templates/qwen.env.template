# ============================================
# Qwen (通义千问) 快速配置模板
# ============================================
# 复制本文件内容到项目根目录的 .env 文件
# 替换 API Key 即可使用
#
# 特点：
# - 质量很高（尤其 qwen-max）
# - 中文优化好
# - 国内访问稳定
# - 适合追求质量的场景
# ============================================

# Qwen API 配置
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ⚠️ 替换为您的 API Key
QWEN_MODEL="qwen-max"

# 全局默认：使用 Qwen
DEFAULT_LLM_PROVIDER="QWEN"

# 内容排序：使用 Qwen Max（高质量判断）
AI_CONTENT_RANKER_LLM_PROVIDER="QWEN:qwen-max"

# 内容总结：使用 Qwen Max（生成高质量文章）
AI_SUMMARIZER_LLM_PROVIDER="QWEN:qwen-max"

# 单 URL 转载：使用 Qwen Turbo（快速处理）
SINGLE_URL_LLM_PROVIDER="QWEN:qwen-turbo"
