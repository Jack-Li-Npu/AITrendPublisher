# ============================================
# 混合配置模板（推荐）
# ============================================
# 不同场景使用不同模型，实现成本与效果的最佳平衡
#
# 策略：
# - 轻量任务：Gemini（免费）
# - 日常任务：DeepSeek（便宜）
# - 重要文章：Qwen Max（质量高）
# - 复杂分析：DeepSeek Reasoner（推理强）
# ============================================

# DeepSeek 配置（主力模型）
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ⚠️ 替换
DEEPSEEK_MODEL="deepseek-chat|deepseek-reasoner"

# Qwen 配置（高质量场景）
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ⚠️ 替换
QWEN_MODEL="qwen-max|qwen-turbo"

# Gemini 配置（免费场景）
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # ⚠️ 替换
GEMINI_MODEL="gemini-2.0-flash-exp"

# ============================================
# 分场景配置（各取所长）
# ============================================

# 全局默认：使用 DeepSeek（性价比高）
DEFAULT_LLM_PROVIDER="DEEPSEEK"

# 内容排序：使用 DeepSeek Reasoner（推理任务需要思考能力）
AI_CONTENT_RANKER_LLM_PROVIDER="DEEPSEEK:deepseek-reasoner"

# 内容总结：使用 Qwen Max（文章生成需要高质量）
AI_SUMMARIZER_LLM_PROVIDER="QWEN:qwen-max"

# 单 URL 转载：使用 Gemini（轻量任务用免费的）
SINGLE_URL_LLM_PROVIDER="GEMINI:gemini-2.0-flash-exp"
