# ============================================
# TrendPublish 环境配置
# 运行 setup.sh 后自动复制为 .env
# API 密钥可在前端控制面板配置
# ============================================

# Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# 默认 LLM
DEFAULT_LLM_PROVIDER=DEEPSEEK

# 微信公众号
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
NEED_OPEN_COMMENT=false
ONLY_FANS_CAN_COMMENT=false
AUTHOR=

# 数据库
ENABLE_DB=false

# 文章配置
ARTICLE_NUM=5
ENABLE_DEDUPLICATION=false

# FireCrawl 数据采集
FIRE_CRAWL_API_KEY=
FIRE_CRAWL_BASE_URL=https://api.firecrawl.dev/v1
SERPER_API_KEY=

# 通知
ENABLE_BARK=false
BARK_URL=

# 图片生成
IMAGE_GENERATOR_TYPE=QWEN_IMAGE_MAX
OVERVIEW_IMAGE_GENERATOR_TYPE=QWEN_IMAGE_MAX
DEFAULT_COVER_IMAGE_URL=

# 内容模式
CONTENT_MODE=AI_NEWS_SITE
ARTICLE_MIN_LENGTH=800
ARTICLE_MAX_LENGTH=1200

# SINGLE_URL 转载模式
SINGLE_URL_LLM_PROVIDER=
SINGLE_URL_LLM_MODEL=
USE_DOOCS_MD_RENDERER=true

# 文章模板
ARTICLE_TEMPLATE_TYPE=academic

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 摘要和预提取模型
AI_SUMMARIZER_LLM_PROVIDER=DEEPSEEK
AI_PRE_EXTRACT_LLM_PROVIDER=DEEPSEEK

# 阿里云通义 (Qwen)
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=cn

# API 访问模式
API_SOURCE_TYPE=official

# Scheduled workflows are opt-in; UI runs preview before draft upload.
ENABLE_CRON=false
